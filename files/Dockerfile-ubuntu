# FastPlaz on Ubuntu (base image: luri/free-pascal)
# build (local):
#   ./build.sh            -> fastplaz/ubuntu:latest
# build & push multi-arch:
#   ./build.sh ubuntu --push
# enter bash:
#   docker run -it fastplaz/ubuntu bash

FROM luri/free-pascal:multiarch AS base

WORKDIR /projects
COPY ./app/ /app
# /app/run.sh is provided by the base image
RUN chmod +x /app/*.sh

# Environment
ENV NAME=FastPlaz
ENV DEBIAN_FRONTEND=noninteractive

# Prepare FastPlaz
RUN /app/fastplaz-init.sh

# Prepare Echo Project (example)
COPY ./project-examples/echo /projects/echo/
RUN ln -fs /projects/echo/public_html /var/www/html/echo && \
  chmod -R 777 /projects/echo/public_html/ztemp

# Build Echo Project (example)
RUN cd /projects/echo/source/echo/ && \
  chmod +x ./*.sh && \
  ./build.sh && \
  test -f /projects/echo/public_html/echo.bin

# run apache
CMD ["/app/run.sh"]
